rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user can only access the documents stored under their
    // own Firebase Authentication UID.
    //
    // For a one-person app, this keeps your sets private. If somebody else
    // signs into the public GitHub Pages site, they cannot read your data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}
