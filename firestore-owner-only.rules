rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // OPTIONAL STRICT ONE-USER VERSION:
    // Replace PASTE_YOUR_FIREBASE_UID with the UID shown by Learn Mode
    // after you sign in successfully.
    //
    // This prevents every other Firebase account from using this database,
    // even for their own separate data.

    function isOwner() {
      return request.auth != null
             && request.auth.uid == "PASTE_YOUR_FIREBASE_UID";
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner()
                         && userId == request.auth.uid;
    }
  }
}
